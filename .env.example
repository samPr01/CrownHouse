DATABASE_URL=
MIGRATION_DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_URL=http://localhost:3003
APP_ENV=development
# disabled, demo (no stock mutation), or cod (verified stock required)
CHECKOUT_MODE=cod

# Server-only transactional emails: sender must be verified in Resend
RESEND_API_KEY=
ORDER_EMAIL_FROM=
ORDER_EMAIL_TO=hello@crownhouse.in
# Generate a random secret of at least 32 characters
CRON_SECRET=
# Server-only administrator allowlist. Only confirmed Supabase accounts qualify.
ADMIN_EMAILS=your-confirmed-admin@example.com
# Optional dedicated random secret; defaults to CRON_SECRET if omitted
RATE_LIMIT_SECRET=
# Optional comma-separated six-digit delivery PIN allowlist; empty means India-wide checkout
DELIVERY_PIN_CODES=
# 32 random bytes encoded as base64. Keep separately from encrypted backups.
BACKUP_ENCRYPTION_KEY=
# Separate EMPTY staging target only; source-project restore is blocked
RESTORE_DATABASE_URL=
