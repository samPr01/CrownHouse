{
  "name": "ecommerce-website",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:seed": "tsx scripts/db/seed.ts",
    "db:check": "tsx scripts/db/check.ts",
    "test": "node --conditions=react-server --import tsx --test tests/order-input.test.ts tests/order-email.test.ts tests/auth-validation.test.ts tests/fulfilment.test.ts tests/backup.test.ts",
    "db:stock": "tsx scripts/db/stock.ts",
    "db:verify": "node --conditions=react-server --import tsx scripts/db/verify.ts",
    "emails:retry": "node --conditions=react-server --import tsx scripts/emails/retry.ts",
    "db:verify-accounts": "node --conditions=react-server --import tsx scripts/db/verify-accounts.ts",
    "db:verify-fulfilment": "node --conditions=react-server --import tsx scripts/db/verify-fulfilment.ts",
    "deploy:check": "tsx scripts/deploy-check.ts",
    "db:backup": "tsx scripts/db/backup.ts",
    "db:restore": "tsx scripts/db/restore.ts",
    "db:verify-backup": "tsx scripts/db/verify-backup.ts",
    "db:verify-concurrency": "node --conditions=react-server --import tsx scripts/db/verify-concurrency.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@iconify/react": "^6.0.2",
    "@supabase/ssr": "0.9.0",
    "@supabase/supabase-js": "2.99.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "18.0.7",
    "drizzle-orm": "0.45.4",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.16.0",
    "motion": "^12.38.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "postgres": "3.4.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "server-only": "0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.0",
    "postcss": "^8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.1",
    "tsx": "4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
